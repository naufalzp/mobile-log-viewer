# Copy to .env and fill in your apps. Comma separated. Real environment variables override this file.

# Android package names. Matched by prefix, so com.example.myapp also covers .debug and :remote processes.
MLOG_ANDROID_APPS=com.example.myapp

# iOS process names (the executable of the app and of each extension).
MLOG_IOS_APPS=MyApp,MyAppNotificationExtension

# PORT=7799
